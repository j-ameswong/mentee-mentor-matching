<%#alex%>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Support</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<% @title = "Support" %>
<%= erb :"common/header" %>

<body>
  <div class = "content">
    <h2>HELP AND SUPPORT</h2>
    <div class = "row centerer">
      <form action = "/support" method = "post">
        <label for="help-request-type">What do you need help with?:</label>
        <select id = "help-category">
          <option value = "option1">Account Deletion</option>
          <option value = "option2">Report User</option>
          <option value = "option3">Other</option>
        </select><br><br><br><br><br>
        <label for="help-request">Please Specify: </label>
        <br>
        <br>
        <textarea id = "help-request"></textarea>
        <br>
        <br>
        <input type="submit" value ="Submit">
      </form>
    </div>
  </div>
</body>


</html>
