<%#alex%>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Support</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" href="/images/UniConnectLogo.png" type="image/x-icon">
</head>

<% @title = "Support" %>
<%= erb :"common/header" %>

<body>
  <div class="content centerer">
    <h2>Help and Support</h2>
    <div class="content-box centerer">
      <form action = "/support" method = "post">
        <label for="help-request-type">What do you need help with?:</label>
        <select name="type" id="help-category">
          <% TicketType.each do |row| %>
            <option <%= "selected" if @type && @type == row.id %> value="<%= row.id %>"><%= row.desc_brief %></option>
          <% end %>
        </select>

        <select name="target_id">
          <% if @target_id %>
            <option selected value=<%= @target_id %>><%= User.first(id: @target_id).username %></option>
          <% end %>
          <% if session[:user].mentor? %>
            <% Match.where(mentor_id: session[:user].id, status: "active").each do |row| %>
              <option value=<%= row.mentee_id %>><%= row.mentee.username %></option>
            <% end %>
          <% end %>
        </select>

        <br><br><br><br><br>
        <label for="help-request">Please Specify: </label>
        <br>
        <br>
        <textarea name="details" id="help-request"></textarea>
        <br>
        <br>
        <input type="submit" value ="Submit">
      </form>
    </div>
  </div>
</body>


</html>
