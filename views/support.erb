<%#alex%>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Support</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" href="/images/UniConnectLogo.png" type="image/x-icon">
</head>

<% @title = "Support" %>
<%= erb :"common/header" %>

<body>
  <div class="content centerer">
    <h2>Help and Support</h2>
    <div class="content-box centerer">
      <form action = "/support" method = "post">
        <label for="help-request-type">What do you need help with?:</label>
        <select name="type" id="help-category">
          <% TicketType.each do |row| %>
            <option <%= "disabled" if User.first(id: @target_id) %>
                    <%= "selected" if @type == row.id %> value="<%= row.id %>"><%= row.desc_brief %></option>
          <% end %>
          <% if User.first(id: @target_id) %>
            <input hidden name="type" value=<%= @type %>>
          <% end %>
        </select>

        <select name="target_id">
          <% if session[:user].mentor? %>
            <% if User.first(id: @target_id) %>
              <option selected value=<%= @target_id %>><%= User.first(id: @target_id).profile.full_name %></option>
            <% end %>
            <% Match.where(mentor_id: session[:user].id, status: "active").each do |row| %>
              <% if @target_id != row.mentee_id %>
                <option value=<%= row.mentee_id %>><%= row.mentee.profile.full_name %></option>
              <% end %>
            <% end %>
          <% elsif session[:user].mentee? %>
            <% match = Match.first(mentee_id: session[:user].id, status: "active") %>
            <% if match.nil? || (match && User.first(id: @target_id) && @target_id != match.mentor_id) %>
              <option value=<%= @target_id %>><%= User.first(id: @target_id).profile.full_name %></option>
            <% end %>

            <% unless match.nil? %>
              <option value=<%= match.mentor_id %>><%= match.mentor.profile.full_name %></option>
            <% end %>
          <% end %>
        </select>

        <br><br><br><br><br>
        <label <%= "style='color: red'" if @errors && @errors[:details] %> for="help-request">Please Specify/Provide good reasoning: </label>
        <p style="color: red"><%= @errors[:exists] if @errors && @errors[:exists] %></p>
        <br>
        <br>
        <textarea name="details" id="help-request"></textarea>
        <br>
        <br>
        <input type="submit" value ="Submit">
      </form>
    </div>
  </div>
</body>


</html>
