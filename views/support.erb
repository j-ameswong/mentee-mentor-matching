<%#alex%>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Support</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" href="/images/UniConnectLogo.png" type="image/x-icon">
</head>

<% @title = "Support" %>
<%= erb :"common/header" %>

<body>
  <div class="content centerer">
    <h2>Help and Support</h2>
    <div class="content-box centerer">
      <form action = "/support" method = "post">
        <label for="help-request-type">What do you need help with?:</label>
        <select id = "help-category">
          <option value = "option1">Option 1</option>
          <option value = "option2">Option 2</option>
          <option value = "option3">Option 3</option>
          <option value = "option4">Option 4</option>
          <option value = "option5">Option 5</option>
        </select><br><br><br><br><br>
        <label for="help-request">Please Specify: </label>
        <textarea id = "help-request"></textarea>
        <input type="submit" value ="Submit">
      </form>
    </div>
  </div>
</body>


</html>
