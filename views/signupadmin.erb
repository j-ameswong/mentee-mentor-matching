<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Sign Up</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<%= erb :loginHeader %>

<body>
  <div class="content signupPage centerer">
    <section id="signup" class="centerer">

      <h2>Sign up for new admin account</h2>

      <form action="/signup/admin" method="post">
        <div class="row centerer">
          <p>University Email:</p>
          <input name="university_email" type="email" placeholder="University Email" autocomplete="on" />
          <% if !@user.nil? && @user.errors.include?("email") %>
            <% @user.errors["email"].each do |error| %>
              <p class="error"><%= error %></p>
            <% end %>
          <% end %>
        </div>
        <br>
        <div class="row centerer">
          <input type="submit" value="Register">
        </div>
      </form>
      <br>
      <a id="login-link" href="/login">Log in instead</a>
    </section>
  </div>
</body>


</html>
