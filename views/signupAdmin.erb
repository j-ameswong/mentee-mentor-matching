<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Sign Up</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" href="/images/UniConnectLogo.png" type="image/x-icon">
</head>

<% @title = "Admin Sign Up" %>
<%= erb :"common/loginHeader"%>

<body>
  <div class="content signupPage centerer">
    <section id="signup-admin" class="centerer">

      <h2>Sign up for new admin account</h2>

      <form action="/signup/admin" method="post">
        
        <div class="row centerer">
          <p><label for="email">University Email:</label></p>
          <input id="email" name="email" type="email" placeholder="University Email Address" autocomplete="on" />
          <% if @user && @user.errors[:email] %>
            <% @user.errors[:email].each do |error| %>
              <p class="error"><%= "Email" + error.tr(':', '') %></p>
            <% end %>
          <% end %>
        </div>
        <br>
        <br>

        <div id="tnc" class="row centerer">
            
          <label for="terms">
            <input id="terms" type="checkbox" name="terms" value="terms_accepted" />
            <span></span>
            By signing up, you agree to our <a target="_blank" href="/terms">Terms & Conditions</a>
          </label>
          <% if @user && @user.errors[:terms] %>
            <% @user.errors[:terms].each do |error| %>
              <p class="error"><%= "Terms and Conditions" + error.tr(':', '') %></p>
            <% end %>
          <% end %>
        </div>
        <br>

        <div class="row centerer">
          <input type="submit" value="Register">
        </div>
      </form>
      <br>
      <a id="login-link" href="/login">Log in instead</a>
    </section>
  </div>
</body>


</html>
