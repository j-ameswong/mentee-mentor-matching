<%# Saul %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Login</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<%= erb :loginHeader %>

<body>
  <div class="content centerer">
    <section id="login" class="centerer">

      <h2>Log in</h2>

      <form method="post">

        <div class="row centerer">

          <div class="column">
            <p>Username/University Email:</p>
            <input name="field" type="text" autocomplete="on" />
            <% if !@user.nil? && @user.errors.include?("field") %>
              <% @user.errors["field"].each do |error| %>
                <p><%= error %></p>
              <% end %>
            <% end %>

          </div>
          <div class="column">
            <p>Password:</p>

            <input name="password" type="password" />
            <% if !@user.nil? && @user.errors.include?("password") %>
              <% @user.errors["password"].each do |error| %>
                <p><%= error %></p>
              <% end %>
            <% end %>
          </div>
        </div>
        <br>
        <div class="column">
          <div class="row centerer">

            <input type="submit" value="Log in">
          </div>
        </div>
        <% if !@user.nil? && !@user.errors["approval"].nil? %>
          <% @user.errors["approval"].each do |error| %>
            <p><%= error %></p>
          <% end %>
        <% end %>
      </form>
      <br>
      <a href="/signup">Sign up instead</a>
    </section>
  </div>

</body>


</html>
