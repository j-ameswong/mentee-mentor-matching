<%# Saul %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Login</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<%= erb :header2 %>

<body>
  <div class="signupPage centerer">
    <section id="login" class="centerer">
      <h2>Log in</h2>
      <form method="post">
        <div class="row centerer">
          <div class="column">
            <p>University Email:</p>
            <input name="university_email" type="email" autocomplete="on" />
            <% if !@user.nil? && !@user.errors["email"].nil? %>
              <% @user.errors["email"].each do |error| %>
                <p><%= error %></p>
              <% end %>
            <% end %>
          </div>
          <div class="column">
            <p>Password:</p>
            <input name="password" type="password" />
            <% if !@user.nil? && !@user.errors["password"].nil? %>
              <% @user.errors["password"].each do |error| %>
                <p><%= error %></p>
              <% end %>
            <% end %>
          </div>
        </div>
        <br>
        <div class="column">
          <div class="row centerer">
            <input type="submit" value="Log in">
          </div>
        </div>
        <% if !@user.nil? && !@user.errors["approval"].nil? %>
          <% @user.errors["approval"].each do |error| %>
            <p><%= error %></p>
          <% end %>
        <% end %>
      </form>
      <br>
      <a href="/signup">Sign up instead</a>
    </section>
  </div>
</body>

<%= erb :footer %>

</html>
