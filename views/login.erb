<%# Saul %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Login</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<% @title = "Log In" %>
<%= erb :"common/loginHeader"%>

<body>
  <div class="content centerer">
    <section id="login" class="centerer">

      <h2>Log in</h2>

      <form method="post">

        <div class="column">
          <div class="row centerer">
            <label class="login-text" for="field">Username/University Email Address:</label>
          </div>
          <br>

          <div class="row centerer">
            <input id="field" name="field" type="text" placeholder="Username or University Email Address" />
            <% if @user && @user.errors[:field] %>
              <% @user.errors[:field].each do |error| %>
                <p><%= error %></p>
              <% end %>
            <% end %>
          </div>
          <br>
          <br>
        
          <div class="row centerer">
            <label class="login-text" for="password">Password:</label>
          </div>
          <br>

          <div class="row centerer">
            <input id="password" name="password" type="password" placeholder="Your Password" />
            <% if @user && @user.errors[:password] %>
              <% @user.errors[:password].each do |error| %>
                <p><%= error %></p>
              <% end %>
            <% end %>
          </div>
          <br>
          <br>

          <div class="row centerer">
            <input type="submit" value="Log in">
          </div>
        </div>

        <% if @user && @user.errors[:approval] %>
          <% @user.errors[:approval].each do |error| %>
            <p><%= error %></p>
          <% end %>
        <% end %>
      </form>
      <br>
      <a href="/signup">Sign up instead</a>
    </section>
  </div>

</body>


</html>
