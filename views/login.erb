<%# Saul %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Login</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<%= erb :header2 %>

<body>
  <div class="signupPage centerer">
    <section id="login" class="centerer">
      <% if @form_was_submitted  %> 
      <h1>GREAT SUCCESS</h1>
      <% end %>
        <h2>Log in</h2>
        <form method="post">
          <label>
            <div class="row centerer">
              <div class="column">
                <p>University Email:</p>
                <input name="university_email" type="email" autocomplete="on" />
              <% if @user.errors.include?("password") %>
                  <% @user.errors["password"].each do |error| %>
                    <p><strong><%= error %></strong></p>
                  <% end %>
                <% end %>
              </div>
              <div class="column">
                <p>Password:</p>
                <input name="password" type="password" />
                <% if @user.errors.include?("password") %>
                  <% @user.errors["password"].each do |error| %>
                    <p><strong><%= error %></strong></p>
                  <% end %>
                <% end %>
              </div>
            </div>
            <br>
            <div class="column">
              <div class="row centerer">
                <input type="submit" value="Log in">
              </div>
            </div>
          </label>
        </form>
        <br>
        <a href="/signup">Sign up instead</a>
    </section>
  
</body>

<%= erb :footer %>

</html>
