<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Matches</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<% @title = "Matching" %>
<%= erb :"common/header" %>

<body>
    <div class="content">
        <h2 id="welcome" class="centerer">Mentees</h2>
        <div id="matching-list" class="content-box">
            <div id="mentee-applicants">
                <h2>Matched Mentees</h2>
                <% unless @mentees.nil? %>
                    <% @mentees.all.each do |row| %>
                        <div class="profile-box">
                            <% mentee = row.mentee.profile %>
                            <div class="basic-info centerer">
                                <div class="profile_pic">
                                <% if mentee.profile_picture %>
                                    <img class="pfp-img" src="<%= "/images/user/#{mentee.profile_picture}" %>" alt="Profile Picture" onerror="this.src='/images/blankProfilePicture.webp'">
                                <% else %>
                                    <img class="pfp-img" src="/images/blankProfilePicture.webp" alt="Profile Picture">
                                <% end %>
                                </div>
                                <p class="profile-name"><%= mentee.first_name %> <%= mentee.last_name %></p>
                            </div>
                            <div class="detailed-info">
                                <p class="detailed-info-content">Age: <%= mentee.age %></p>
                                <p class="detailed-info-content">Nationality: <%= Nationality.first(id: mentee.nationality_id).country_name %></p>
                                <p class="detailed-info-content">Languages: 
                                    <% UserLanguage.where(user_id: row.mentee_id).each do |ulanguage| %>
                                        <%= ulanguage.language.language_name %>
                                    <% end %>
                                </p>
                            </div>
                            <div class="bio-and-accept">
                                <p class="profile-bio-detailed">Bio: <%= mentee.bio_brief %></p>
                                <% if SupportTicket.withdrawing?(row) %>
                                    <p class="profile-bio-detailed" style="color: red"><%= TicketType.first(id: SupportTicket.withdraw?).description %></p>
                                <% end %>
                                <div class="matching-wrapper" id="<%= mentee.user_id %>-wrapper">
                                    <a class="view-profile" href=<%="/profile?id=#{mentee.user_id}"%>>View detailed profile and contact information</a>
                                  <form method="post" action="/matches/matched/mentor">
                                    <input hidden name="target_id" value=<%= mentee.user_id %>>
                                    <% unless SupportTicket.withdrawing?(row) %>
                                      <button type="submit" name="withdrawal" class="withdraw-mentor" id="<%= mentee.user_id %>-withdraw">Withdraw</button>
                                    <% end %>
                                    <button type="submit" name="report" class="report-mentor" id="<%= mentee.user_id %>-report">Report</button>
                                  </form>
                                </div>
                            </div>
                        </div>
                    <% end %>
                <% end %>
            </div>
        </div>
    </div>
</body>

</html>