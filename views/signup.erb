<%# Saul %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Sign Up</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<%= erb :header2 %>

<%# TODO: @luqman IMPLEMENT VALIDATION AND SANITATION, i.e. WITH STRIP AND @error ARRAY %>
<body class="signupPage">
  <div class="centerer">
    <section id="signup" class="centerer">
        <h2>Sign up for new account</h2>
        <form action="/signup" method="post">
            <div class="row centerer">
              <div class="column">
                <p>First Name:</p>
                <input name="first_name" autocomplete="on" />
                <% @user = User.new %>
                <% if @user.errors.include?("first_name") %>
                  <% @user.errors["first_name"].each do |error| %>
                    <p class="error"><strong> first name </strong></p>
                  <% end %>
                <% end %>
              </div>
          
              <div class="column">
                <p>Last Name:</p>
                <input name="last_name" autocomplete="on" />
                <% if @user.errors.include?("last_name") %>
                  <% @user.errors["last_name"].each do |error| %>
                    <p class="error"><strong> Last name </strong></p>
                  <% end %>
                <% end %>
              </div>
            </div>

            <div class="row centerer">
              <div class="column">
                <p>University Email:</p>
                <input name="university_email" type="email" autocomplete="on" />
              </div>

              <div class="column">
                <p>DoB:</p>
                <input name="date_of_birth" type="date" />
                <% if @user.errors.include?("date_of_birth") %>
                  <% @user.errors["date_of_birth"].each do |error| %>
                    <p class="error"><strong> Date of birth </strong></p>
                  <% end %>
                <% end %>
              </div>

              <div class="column">
                <p>Role:</p>
                <select name="acc_type">
                  <option value="Mentee">Mentee</option>
                  <option value="Mentor">Mentor</option>
                </select>
              </div>
            </div>

            <div class="column">
              <div class="row centerer">
                <p>Password:</p>
              </div>

              <div class="row centerer">
                <input name="password" type="password" />
                <% if @user.errors.include?("password") %>
                  <% @user.errors["password"].each do |error| %>
                    <p class="error"><strong> Password </strong></p>
                  <% end %>
                <% end %>
              </div>
            
              <div class="row centerer">
                <p>Confirm Password:</p>
              </div>

              <div class="row centerer">
                <input name="password-confirm" type="password" />
                <% if @user.errors.include?("password_mismatch") %>
                  <% @user.errors["password_mismatch"].each do |error| %>
                    <p class="error"><strong> Confirm Password </strong></p>
                  <% end %>
                <% end %>
              </div>

              <br>
              <div class="row centerer">
                <input type="submit" value="Register">
              </div>

              <div id="tnc" class="row">
                <input class="column" type="checkbox" name="terms" value="terms_accepted">
                <label class="column" for="terms">By signing up, you agree to our <a target="_blank" href="/terms">Terms & Conditions</label>
              </div>
            </div>
        </form>
        <br>
        <a href="/login">Log in instead</a>
    </section>
</body>

<%= erb :footer %>
<%password = params.fetch("password", "").strip%>
<%confirm_pass = params.fetch("password-confirm", "").strip%>
<% puts @user.validate%>
<% puts @user.errors %>

</html>
