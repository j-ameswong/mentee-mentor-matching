<%# Saul %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Sign Up</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<%= erb :header2 %>

<body>
  <div class="signupPage centerer">
    <section id="signup" class="centerer">
        <h2>Sign up for new account</h2>
        <form action="/signup" method="post">
          <label>
            <div class="row centerer">
              <div class="column">
                <p>First Name:</p>
                <input name="first_name" autocomplete="on" />
              </div>
              <div class="column">
                <p>Last Name:</p>
                <input name="last_name" autocomplete="on" />
              </div>
            </div>
            <div class="row centerer">
              <div class="column">
                <p>University Email:</p>
                <input name="university_email" type="email" autocomplete="on" />
              </div>
              <div class="column">
                <p>DoB:</p>
                <input name="date_of_birth" type="date" />
              </div>
              <div class="column">
                <p>Role:</p>
                <select name="acc_type">
                  <option value="mentee">Mentee</option>
                  <option value="mentor">Mentor</option>
                </select>
              </div>
            </div>
            <div class="column">
              <div class="row centerer">
                <p>Password:</p>
              </div>
              <div class="row centerer">
                <input name="password" type="password" />
              </div>
            
              <div class="row centerer">
                <p>Confirm Password:</p>
              </div>
              <div class="row centerer">
                <input name="password-confirm" type="password" />
              </div>
              <br>
              <div class="row centerer">
                <input type="submit" value="Register">
              </div>
            </div>
          </label>
        </form>
        <br>
        <a href="/login">Log in instead</a>
    </section>
</body>

<%= erb :footer %>

</html>
