<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Sign Up</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" href="/images/UniConnectLogo.png" type="image/x-icon">
</head>

<% @title = "Sign Up" %>
<%= erb :"common/loginHeader"%>

<%# TODO 2: Consistent password requirements with account/changePassword page %>
<body>
  <div class="signupPage content centerer">

    <section id="signup" class="centerer">

      <h2>Sign up for new account</h2>

      <form action="/signup" method="post">

        <div class="column centerer">

          <div class="row centerer">
            <label for="username">Username:</label>
          </div>
          <br>

          <div class="row centerer">
            <input name="username" id="username" type="text" value="<%= @user.username if @user %>" placeholder="New Username" required/>
            <% if @user && @user.errors[:username] %>
              <% @user.errors[:username].each do |error| %>
                <p class="error"><%= error %></p>
              <% end %>
            <% end %>
          </div>
          <br>
          <br>

          <div class="row centerer">
            <label for="first_name">First Name:</label>
          </div>
          <br>

          <div class="row centerer">
            <input name="first_name" id="first_name" type="text" value="<%= @params[:first_name] if @user && @params %>" placeholder="Your First Name" required/>
            <% if @user && @user.errors[:first_name] %>
              <% @user.errors[:first_name].each do |error| %>
                <p class="error"><%= error %></p>
              <% end %>
            <% end %>
          </div>
          <br>
          <br>

          <div class="row centerer">
            <label for="last_name">Last Name:</label>
          </div>
          <br>

          <div class="row centerer">
            <input name="last_name" id="last_name" type="text" value="<%= @params[:last_name] if @user && @params %>" placeholder="Your Last Name" required/>
            <% if @user && @user.errors[:last_name] %>
              <% @user.errors[:last_name].each do |error| %>
                <p class="error"><%= error %></p>
              <% end %>
            <% end %>
          </div>
          <br>
          <br>

          <div class="row centerer">
            <label for="email">University Email:</label>
          </div>
          <br>

          <div class="row centerer">
            <input id="email" name="email" type="email" value="<%= @user.email if @user %>" placeholder="University Email Address" required/>
            <% if @user && @user.errors[:email] %>
              <% @user.errors[:email].each do |error| %>
                <p class="error"><%= error %></p>
              <% end %>
            <% end %>
          </div>
          <br>
          <br>

          <div class="row centerer">

            <div class="column centerer">

              <div class="row centerer">
                <label for="date_of_birth">DoB:</label>
              </div>
              <br>

              <div class="row centerer">
                <input id="date_of_birth" name="date_of_birth" type="date" value="<%= @params[:date_of_birth] if @params %>" required/>
                <% if @user && @user.errors[:date_of_birth] %>
                  <% @user.errors[:date_of_birth].each do |error| %>
                    <p class="error"><%= error %></p>
                  <% end %>
                <% end %>
              </div>

            </div>

            <div class="column centerer">

              <div class="row centerer">
                <label for="role">Role:</label>
              </div>
              <br>

              <div class="row centerer">
                <select id="role" name="role" required>
                  <option value="mentee" <%="selected" if @user && @user.mentee? %>>Mentee</option>
                  <option value="mentor" <%="selected" if @user && @user.mentor? %>>Mentor</option>
                </select>

                <% if @user && @user.errors[:role] %>
                  <% @user.errors[:role].each do |error| %>
                    <p class="error"><%= error %></p>
                  <% end %>
                <% end %>
              </div>
            </div>

            <div class="column">
              <div class="row centerer">
                <label for="year_of_study">Year of study:</label>
              </div>
              <br>

              <div class="row centerer">
                <select id="year_of_study" name="year_of_study" required>
                  <% (1..4).each do |y| %>
                    <option value='<%= y %>' <%="selected" if @user && @params[:year_of_study] == y %>>Year <%= y %></option>>
                  <% end %>
                </select>
              </div>
            </div>
          </div>
          <br>
          <br>
        
          <div class="row centerer">
            <label for="password">Password:</label>
          </div>
          <br>

          <div class="row centerer">
            <input id="password" name="password" type="password" placeholder="New Password" />
            <% if @user && @user.errors[:password] %>
              <% @user.errors[:password].each do |error| %>
                <p class="error"><%= error %></p>
              <% end %>
            <% end %>
          </div>
          <br>
          <br>

          <div class="row centerer">
            <label for="confirm_password">Confirm Password:</label>
          </div>
          <br>

          <div class="row centerer">
            <input id="confirm_password" name="confirm_password" type="password" placeholder="Re-enter Password" />
            <% if @user && @user.errors[:confirm_password] %>
              <% @user.errors[:confirm_password].each do |error| %>
                <p class="error"><%= error %></p>
              <% end %>
            <% end %>
          </div>
          <br>

          <div id="tnc" class="row centerer">
            
            <label for="terms">
              <input id="terms" type="checkbox" name="terms" value="terms_accepted" />
              <span></span>
              By signing up, you agree to our <a target="_blank" href="/terms">Terms & Conditions</a>
            </label>
          </div>
          <br>

          <div class="row centerer">
            <input type="submit" value="Register">
          </div>
        </div>
      </form>

      <p><a href="/login">Log in instead</a></p>
    </section>
  </div>
</body>


</html>
