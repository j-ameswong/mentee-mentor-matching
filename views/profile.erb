<%# Saul %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Profile</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<%= erb :header %>

<body>
  <section id="profile" class="centerer column">
    <% @user = User.first(university_email: session[:username]) %>
    <% @edit = params.fetch("edit", "0") %>
    
    <form method="post" action="/profile?edit=<%= @edit == "0" ? "1" : "0" %>">    
      <figure class="row">
        <img width="150" src="/profile/get_image" alt="Not Found" onerror="this.src='/images/blankProfilePicture.webp'"/>
      </figure>

      <div class="info row">
        <p>First Name: <%= @user.first_name if @edit == "0"%></p>
        <%= '<input type="text" name="first_name" value="' + @user.first_name + '" required>' if @edit == "1"%>
      </div>

      <div class="info row">
        <p>Last Name: <%= @user.last_name if @edit == "0" %></p>
        <%= '<input type="text" name="last_name" value="' + @user.last_name + '" required>' if @edit == "1"%>
      </div>

      <div class="info row">
        <p>University Email: <%= @user.university_email if @edit == "0" %></p>
        <%= '<input type="text" name="university_email" value="' + @user.university_email + '" required>' if @edit == "1"%>
      </div>

      <div class="info row">
        <p><%= @edit == "0" ? ("Age: " + @user.age(@user.date_of_birth).to_s) : "Date of Birth:"%></p>
        <%= '<input type="date" name="date_of_birth" value="' + @user.date_of_birth + '" required>' if @edit == "1"%>
      </div>

      <div class="info row">
        <p>Role: <%= @user.acc_type if @edit == "0" %></p>
        <%= '<select name="acc_type" required>' if @edit == "1"%>
          <%= '<option value="mentee" ' if @edit == "1" %>
            <%= 'selected' if @user.acc_type == "mentee" && @edit == "1"%><%= '>' if @edit == "1" %>
          <%= 'Mentee</option>' if @edit == "1"  %>
          <%= '<option value="mentor" ' if @edit == "1" %>
            <%= 'selected' if @user.acc_type == "mentor" && @edit == "1"%><%= '>' if @edit == "1" %>
          <%= 'Mentor</option>' if @edit == "1"  %>
        <%= '</select>' if @edit == "1" %> 
      </div>

      <%= '<button type="submit">Save</button>' if @edit == "1" %>
      <%= '<button type="submit">Edit</button>' if @edit == "0" %>
    </form>
  </section>
</body>

<%= erb :footer %>

</html>
