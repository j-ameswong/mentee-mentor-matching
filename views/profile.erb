<%# Saul %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Profile</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<%= erb :header %>

<body>
  <section id="profile" class="centerer column">
    <% @user = User.first(university_email: session[:username]) %>
    <% @edit = params.fetch("edit", "0") %>
    
    <form method="post" action="/profile?edit=<%= @edit == "0" ? "1" : "0" %>">    
      <% if @edit == "0" %>
        <figure class="row">
          <img width="150" src="/profile/get_image" alt="Not Found" onerror="this.src='/images/blankProfilePicture.webp'"/>
        </figure>
      <% else %>
        <input type="file" id="profile_picture" name="profile_pic" accept="image/*">
        <label for="profile_picture">Upload Profile Picture</label>
      <% end %>

      <% if @edit == "1" %>
        <div class="info row">
          <p>First Name: <%= @user.first_name if @edit == "0" %></p>
          <% if @edit == "1" %>
            <input type="text" name="first_name" value="<%= @user.first_name %>" required>
          <% end %>
        </div>

        <div class="info row">
          <p>Last Name: <%= @user.last_name if @edit == "0" %></p>
          <% if @edit == "1" %>
            <input type="text" name="last_name" value="<%= @user.last_name %>" required>
          <% end %>
        </div>
      <% else %>
        <div class="info row">
          <p>Name: <%= @user.first_name + ' ' + @user.last_name %></p>
        </div>
      <% end %>

      <div class="info row">
        <p>University Email: <%= @user.university_email if @edit == "0" %></p>
        <% if @edit == "1" %>
          <input type="text" name="university_email" value="<%= @user.university_email %>" required>
        <% end %>
      </div>

      <div class="info row">
        <% @languages = @user.languages.split(",") unless @user.languages.nil? %>
        <p>Languages Spoken: <%= ' (Comma separated, no spaces)' if @edit == "1" %></p>
      </div>
        
      <div class="info row">
        <ul>
          <% if @edit == "0" && !@languages.nil?%>
            <% @languages.each do |language|%>
              <li><%= language %></li>
            <% end %>
          <% end %>
        </ul>

        <% if @edit == "1" %>
          <input type="text" name="languages" value="<%= @user.languages %>" required>
        <% end %>       
      </div>
      
      <div class="info row">
        <p><%= @edit == "0" ? ("Age: " + @user.age(@user.date_of_birth).to_s) : "Date of Birth:" %></p>
        <% if @edit == "1" %>
          <input type="date" name="date_of_birth" value="<%= @user.date_of_birth %>" required>
        <% end %>
      </div>

      <div class="info row">
        <p>Role: <%= @user.acc_type if @user.acc_type != "admin" %></p>
        <% if @edit == "1" && @user.acc_type == "admin"%>
          <select name="acc_type" required>
            <option value="mentee" <%= 'selected' if @user.acc_type == "mentee" %>>Mentee</option>
            <option value="mentor" <%= 'selected' if @user.acc_type == "mentor" %>>Mentor</option>
          </select>
        <% end %>
      </div>

      <% if @edit == "1" %>
        <button type="submit">Save</button>
      <% else %>
        <button type="submit">Edit</button>
      <% end %>
    </form>
  </section>
</body>

<%= erb :footer %>

</html>
