<%# Saul %>
<!DOCTYPE html>
<html lang="en" class="profilePage">

<head>
  <meta charset="utf-8" />
  <title>Profile</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<% @title = "Profile" %>
<%= erb :"common/header" %>

<body>
  <section class="centerer column">
    <h3><%= @viewed_user.username %>'s Profile</h3>
    <form method="post" action="/profile?id=<%= @viewed_user.id %>" enctype="multipart/form-data">
      <figure class="row profile_pic centerer">
        <%# If profile pic has not been set by user, use default profile picture %>
        <img width="100" height="100" src="/images/user/<%= @viewed_user.profile.profile_pic %>" alt="Not Found"
             onerror="this.src='/images/blankProfilePicture.webp'"/>
      </figure>

      <div class="info row">
        <p>Name: <%= @viewed_user.profile.full_name %></p>
      </div>

      <div class="info row">
        <p>University Email: <%= @viewed_user.email %></p>
      </div>

      <div class="info row languages">
        <%# TODO: change languages csv to db, update schema and migrations @languages = @viewed_user.user_languages unless @viewed_user.languages.nil? %>
        <%# TODO: same as above for nationalities %>
        <p>Languages Spoken: </p>
        <ul>
          <% unless @languages.nil?%>
            <% @languages.each do |language|%>
              <li><%= language %></li>
            <% end %>
          <% end %>
        </ul>
      </div>
      
      <div class="info row">
        <p>Age: <%= @viewed_user.profile.age %></p>
      </div>

      <div class="info row">
        <p>Role: <%= @viewed_user.role.capitalize %></p>
      </div>

      <div class="info row">
        <p>Nationality: <%= @viewed_user.nationality %> </p>
      </div>

      <div class="info row">
        <p>Year of Study: <%= @viewed_user.year_of_study  %> </p>
      </div>

      <div class="info row">
        <div class="row">
          <p>Background Summary:</p>
        </div>
        <div class="row">
          <p><%= @viewed_user.description %></p>
        </div>
      </div>

      <% if session[:user].role == "admin" || @viewed_user.id == session[:user].id %>
        <div class="info row">
          <button type="submit">Edit</button>
        </div>
      <% end %>
    </form>
  </section>
</body>


</html>
