<%# Saul %>
<!DOCTYPE html>
<html lang="en" class="profilePage">

<head>
  <meta charset="utf-8" />
  <title>Profile</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<%= erb :header %>

<%# TODO: IMPLEMENT VIEWING PROFILES WITHOUT ALLOWING EDITS AS A MENTOR/MENTEE %>
<%# TODO: IMPLEMENT ADMINS ALLOWED TO EDIT ALL PROFILES %>

<body>
  <section class="centerer column">
    <h3>Profile</h3>
    <form method="post" action="/profile?edit=<%= @edit %>" enctype="multipart/form-data">   
      <figure class="row profile_pic centerer">
        <img width="100" height="100" src="/images/user/<%= @user.profile_pic %>" alt="Not Found" onerror="this.src='/images/blankProfilePicture.webp'"/>
      </figure>

      <div class="info row">
        <p>Name: <%= @user.first_name + ' ' + @user.last_name %></p>
      </div>

      <div class="info row">
        <p>University Email: <%= @user.university_email %></p>
      </div>

      <div class="info row languages">
        <% @languages = @user.languages.split(",") unless @user.languages.nil? %>

        <ul>
          <% if !@languages.nil?%>
            <% @languages.each do |language|%>
              <li><%= language %></li>
            <% end %>
          <% end %>
        </ul>
      </div>
      
      <div class="info row">
        <p>Age: <%= @user.age(@user.date_of_birth).to_s %></p>
      </div>

      <div class="info row">
        <p>Role: <%= @user.acc_type %></p>
      </div>

      <div class="info row">
        <p>Nationality: <%= @user.nationality %> </p>
      </div>

      <div class="info row">
        <p>Year of Study: <%= @user.year_of_study  %> </p>
      </div>

      <div class="info row">
        <button type="submit">Edit</button>
      </div>
    </form>
  </section>
</body>

<%= erb :footer %>

</html>
