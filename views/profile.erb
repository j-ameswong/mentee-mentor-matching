<%# Saul %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Profile</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<%= erb :header %>

<body>
  <section id="profile" class="centerer column">
    <div id="pic" class="row">
      <figure><img width="200px" src="./images/blankProfilePicture.webp"></figure>
    </div>

    <% @user = User.first(university_email: session[:username]) %>

    <div class="info row">
      <p>First Name: <%= @user.first_name %></p>
    </div>

    <div class="info row">
      <p>Last Name: <%= @user.last_name %></p>
    </div>

    <div class="info row">
      <p>University Email: <%= @user.university_email %></p>
    </div>

    <div class="info row">
      <p>Date of Birth: <%= @user.date_of_birth %></p>
    </div>

    <div class="info row">
      <p>Role: <%= @user.acc_type %></p>
    </div>
  </section>
</body>

<%= erb :footer %>

</html>
