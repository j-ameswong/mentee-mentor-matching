<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Matches</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<% @title = "Matching" %>
<%= erb :"common/header" %>

<body>
  <div class="content">
    <section class="matching row centerer">
        <div class="column centerer">
          <% MentorProfile.each do |row| %>
            <% if row.availability %>
              <div class="row">
                <%="Year" + row.year_of_study %>
                <%= row.user.user_expertises[0] %>
                <%= row.user.profile.age %>
                <%= row.user.profile.bio_brief %>
                <%= Nationality.first(id: row.user.profile.nationality_id).country_name %>
              </div>

              <div class="row">
                <button type="button" id="apply-mentor" class="apply-mentor">Apply</button>
              </div>
              <div class="row">
                <div class="<%= row.user.id %>>" id="matching-wrapper"></div>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>

    <script src="/js/menteeMatching.js"></script>
  </div>
</body>

</html>