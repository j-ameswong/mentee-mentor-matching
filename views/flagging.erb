<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <% @title = "Flagging & Deletion" %>
  <title><%= @title %></title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" href="/images/UniConnectLogo.png" type="image/x-icon">
  <style>
    .modal {
      display: none;
      position: fixed;
      z-index: 1;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0,0,0,0.4);
    }

    .modal-content {
      background-color: #fefefe;
      margin: 15% auto;
      padding: 20px;
      border: 1px solid #888;
      width: 50%;
      border-radius: 5px;
    }

    .modal-content h4 {
      margin-top: 0;
    }

    .modal-content textarea {
      width: 100%;
      min-height: 100px;
      margin-bottom: 10px;
      resize: vertical;
    }

    .modal-buttons {
      display: flex;
      justify-content: flex-end;
    }

    .modal-buttons button {
      margin-left: 10px;
      padding: 8px 16px;
      cursor: pointer;
    }

    .close-modal {
      background-color: #ccc;
      border: none;
      border-radius: 3px;
    }

    .submit-modal {
      background-color: #4CAF50;
      color: white;
      border: none;
      border-radius: 3px;
    }
  </style>
</head>

<body>
<%= erb :"common/header" %>
<section class="content centerer">

  <h3>Flagging & Deletion</h3>

  <div class="content-box centerer">
    <h3>Search for account to flag:</h3>
    <form action="/flagging" method="post">

      <label for="username" class="row centerer">Filter by Username:</label>
      <input type="text" name="username" placeholder="Enter username" value="<%= session[:flag_filters] && session[:flag_filters][:username] %>">

      <div class="column">
        <br>
        <label for="role" class="row">Filter by Account Type:</label>
        <select name="role" id="role" class="row">
          <option value="" selected>Select an account type</option>
          <option value="admin" <%= session[:flag_filters] && session[:flag_filters][:role] == 'admin' ? 'selected' : '' %>>Admin</option>
          <option value="mentee" <%= session[:flag_filters] && session[:flag_filters][:role] == 'mentee' ? 'selected' : '' %>>Mentee</option>
          <option value="mentor" <%= session[:flag_filters] && session[:flag_filters][:role] == 'mentor' ? 'selected' : '' %>>Mentor</option>
        </select>
        <br>
        
        <label for="flag_status" class="row">Filter by Flag Status:</label>
        <select name="flag_status" id="flag_status" class="row">
          <option value="" selected>Any flag status</option>
          <option value="0" <%= session[:flag_filters] && session[:flag_filters][:flag_status] == '0' ? 'selected' : '' %>>Not Flagged</option>
          <option value="1" <%= session[:flag_filters] && session[:flag_filters][:flag_status] == '1' ? 'selected' : '' %>>Flagged</option>
        </select>
        <br>

        <input type="submit" value="Update Filters" class="row centerer">
      </div>
    </form>
  </div>

  <div class="content-box centerer">
    <h3>Search Results: </h3>
    <div class="flagging-table">
        <table>
            <thead>
                <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Account Type</th>
                <th>Flag Status</th>
                <th>Flag Reason</th>
                <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% @users.each do |user| %>
                <tr <%= user.flagged? ? 'class="flagged"' : '' %>>
                    <td><%= user.username %></td>
                    <td><%= user.email %></td>
                    <td><%= user.role.capitalize %></td>
                    <td><%= user.flagged? ? 'Flagged' : 'Not Flagged' %></td>
                    <td><%= user.flag_reasoning %></td>
                    <td>
                    <% if user.flagged? %>
                        <form action="/unflag/<%= user.id %>" method="post" style="display: inline;">
                        <input type="submit" value="Unflag" class="unflag-button">
                        </form>
                    <% else %>
                        <button class="flag-button" onclick="openFlagModal('<%= user.id %>', '<%= user.username %>')">Flag</button>
                    <% end %>
                    <form action="/delete/<%= user.id %>" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                        <input type="submit" value="Delete" class="delete-button">
                    </form>
                    </td>
                </tr>
                <% end %>
            </tbody>
        </table>
      </div>
    </div>
</section>

<!-- Flag Modal -->
<div id="flagModal" class="modal">
  <div class="modal-content">
    <h4>Flag User: <span id="modalUsername"></span></h4>
    <form action="/flag" method="post" id="flagForm">
      <input type="hidden" name="user_id" id="modalUserId">
      <label for="flag_reasoning">Reason for flagging:</label>
      <textarea name="flag_reasoning" id="flag_reasoning" required placeholder="Please provide a reason for flagging this user"></textarea>
      <div class="modal-buttons">
        <button type="button" class="close-modal" onclick="closeModal()">Cancel</button>
        <button type="submit" class="submit-modal">Submit</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/flagModal.js"></script>
</body>
</html>