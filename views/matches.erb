<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Matches</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<% @title = "Matching" %>
<%= erb :"common/header" %>

<body>
  <%# Eventually, we want to only show mentors if logged in as mentee, and vice versas %>
  <% if @accountType == "mentee" %>
    <%= erb :menteeMatching %>
  <% elsif @accountType == "mentor" %>
    <%= erb :mentorMatching %>
  <% end %>
</body>


</html>