<% unless @user.nil? %>
  <% @username = session[:user].username %>
  <% @unread = false %>
  <% UserMessage.where(received_by: @username).each do |message| %>
    <% unless message.read? %>
      <% @unread = true %>
      <% break %>
    <% end %>
  <% end %>

  <div class="notification-wrapper">
    <a href="/message" class="notifications-btn">
      <% if @unread %>
        <img id="bell-icon" src="/images/bell_notify.png" alt="Bell icon">
      <% else %>
        <img id="bell-icon" src="/images/bell.png" alt="Bell icon">
      <% end %>
    </a>
  </div>


<% end %>