<%# for when not logged in (without any options) %>
<% @user = session[:user]%>
<% @accountType = "" %>
<%if !(@user.nil?) %>
    <% @accountType = @user.role %>


    <% if @accountType == "admin" %>
        <% @option2 = "New Users Approval" %>
        <% @link2 = "/approvals" %>
        <% @option3 = "Manage Accounts" %>
        <% @link3 = "/" %>
        <% @option4 = "Flagging & Deletion" %>
        <% @link4 = "/" %>
    <% elsif @accountType == "mentee" %>
        <% @option2 = "Matching" %>
        <% @link2 = "/matches" %>
    <% else %>
        <% @option2 = "Matching" %>
        <% @link2 = "/matches" %>
        <% @option3 = "Mentees" %>
        <% @link3 = "/" %>
    <% end %>

<% else %>
        <% @option2 = "Log In" %>
        <% @link2 = "/login" %>
        <% @option3 = "Sign Up" %>
        <% @link3 = "/signup" %>
<% end %>

<%= erb :"common/title" %>

<%= erb :"common/sidebar" %>

<%= erb :"common/logo" %>

<%if !(@user.nil?)%>
    <%= erb :"common/dropdown" %>
<%end%>