<%# for when not logged in (without any options) %>
<head>
  <link rel="icon" href="/images/UniConnectLogo.png" type="image/x-icon">
</head>

<% @user = session[:user]%>
<% @accountType = "" %>
<%if !(@user.nil?) %>
    <% @accountType = @user.role %>


    <% if @accountType == "admin" %>
        <% @option2 = "New Users Approval" %>
        <% @link2 = "/approvals" %>
        <% @option3 = "Manage Accounts" %>
        <% @link3 = "/accounts" %>
        <% @option4 = "Flagging & Deletion" %>
        <% @link4 = "/flagging" %>
        <% @option5 = "Support Tickets" %>
        <% @link5 = "/support/admin" %>
    <% elsif @accountType == "mentee" %>
        <% @option2 = "Matching" %>
        <% @link2 = "/matches" %>
    <% else %>
        <% @option2 = "Matching" %>
        <% @link2 = "/matches" %>
        <% @option3 = "Mentees" %>
        <% @link3 = "/matches/matched" %>
    <% end %>

<% else %>
        <% @option2 = "Log In" %>
        <% @link2 = "/login" %>
        <% @option3 = "Sign Up" %>
        <% @link3 = "/signup" %>
<% end %>

<%= erb :"common/title" %>

<%= erb :"common/sidebar" %>

<%= erb :"common/logo" %>

<%if !(@user.nil?)%>
    <%= erb :"common/dropdown" %>
    <%= erb :"common/notifications" %>
<%end%>