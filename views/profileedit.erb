<!DOCTYPE html>
<html lang="en" class="profilePage">

<head>
  <meta charset="utf-8" />
  <title>Profile</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<%= erb :header %>

<body>
<section class="centerer column">
  <%# For the below, only admins can edit someone's year of study or account type %>
  <h3>Profile</h3>
  <form method="post" action="/profile/edit" enctype="multipart/form-data">
      <input type="file" id="profile_pic=" name="profile_pic" accept="image/*">
      <label for="profile_pic">Upload Profile Picture</label>

      <div class="info row">
        <label for="first_name">First Name:</label>
        <input type="text" id="first_name" name="first_name" value="<%= @user.first_name %>" required>
      </div>

      <div class="info row">
        <label for="last_name">Last Name:</label>
        <input type="text" id="last_name" name="last_name" value="<%= @user.last_name %>" required>
      </div>

    <div class="info row">
      <label for="university_email">University Email:</label>
      <input type="text" id="university_email" name="university_email" value="<%= @user.university_email %>" required>
    </div>

    <div class="info row languages">
      <% @languages = @user.languages.split(",") unless @user.languages.nil? %>
      <label for="languages">Languages Spoken: (Comma separated, no spaces)</label>
      <input type="text" id="languages" name="languages" value="<%= @user.languages %>" required>
    </div>

    <div class="info row">
      <label for="date_of_birth"></label>
      <input type="date" id="date_of_birth" name="date_of_birth" value="<%= @user.date_of_birth %>" required>
    </div>

    <div class="info row">
      <label for="acc_type">Role:</label>
      <% if @user.acc_type == "admin"%>
        <select id="acc_type" name="acc_type" required>
          <option value="mentee" <%= 'selected' if @user.acc_type == "mentee" %>>Mentee</option>
          <option value="mentor" <%= 'selected' if @user.acc_type == "mentor" %>>Mentor</option>
          <option value="admin" <%= 'selected' if @user.acc_type == "admin" %>>Admin</option>
        </select>
      <% else %>
        <%= @user.acc_type %>
      <% end %>
    </div>

    <div class="info row">
    <label for="nationality">Nationality:</label>
    <select id="nationality" name="nationality" required>
      <% @countries.each do |country| %>
        <option value="<%= country %>" <%= 'selected' if @user.nationality == country %>><%= country %></option>
      <% end %>
    </select>
    </div>

    <div class="info row">
      <label for="year_of_study">Year of Study:</label>

      <% if @user.acc_type == "admin"%>
        <select id="year_of_study" name="year_of_study" required>
          <% # If user already has a year of study, preselect it %>
          <% if !@user.year_of_study.nil? %>
            <% (1..5).each do |year| %>
              <option value="Year <%= year %>" <%= 'selected' if @year_of_study == "Year #{year}" %>>Year <%= year %></option>
            <% end %>
          <% else %>
            <% (1..5).each do |year| %>
              <option value="Year <%= year %>">Year <%= year %></option>
            <% end %>
          <% end %>
        </select>
      <% else %>
        <%= @user.year_of_study %>
      <% end %>
    </div>

    <button type="submit">Save</button>
  </form>
</section>
</body>

<%= erb :footer %>

</html>
