<!DOCTYPE html>
<html lang="en" class="profilePage">

<head>
  <meta charset="utf-8" />
  <title>Profile</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<%= erb :header %>

<%# TODO: IMPLEMENT VIEWING PROFILES WITHOUT ALLOWING EDITS AS A MENTOR/MENTEE %>
<%# TODO: IMPLEMENT ADMINS ALLOWED TO EDIT ALL PROFILES >
<%# TODO: RESTRICT USER PRIVILEGES IN EDITING THEIR PROFILE DETAILS %
<%# TODO: handle nil values for certain fields in user profile %>

<body>
<section class="centerer column">
  <% @edit = params.fetch("edit", "0") %>
  <% @user = session[:user] %>
  <% @id = params.fetch("id", @user.id) %>
  <%# @edit = "0" if @id != @user.id %>
  <% @viewed_user = User.first(id: @id.to_i) if @id.is_a? String %>

  <h3>Profile</h3>
  <form method="post" action="/profile?edit=<%= @edit %>" enctype="multipart/form-data">
    <% if @edit == "0" %>
      <figure class="row profile_pic centerer">
        <img width="100" height="100" src="/images/user/<%= @user.profile_pic %>" alt="Not Found" onerror="this.src='/images/blankProfilePicture.webp'"/>
      </figure>
    <% else %>
      <input type="file" id="profile_pic=" name="profile_pic" accept="image/*">
      <label for="profile_pic">Upload Profile Picture</label>
    <% end %>

    <% if @edit == "1" %>
      <div class="info row">
        <p>First Name: <%= @user.first_name if @edit == "0" %></p>
        <% if @edit == "1" %>
          <input type="text" name="first_name" value="<%= @user.first_name %>" required>
        <% end %>
      </div>

      <div class="info row">
        <p>Last Name: <%= @user.last_name if @edit == "0" %></p>
        <% if @edit == "1" %>
          <input type="text" name="last_name" value="<%= @user.last_name %>" required>
        <% end %>
      </div>
    <% else %>
      <div class="info row">
        <p>Name: <%= @user.first_name + ' ' + @user.last_name %></p>
      </div>
    <% end %>

    <div class="info row">
      <p>University Email: <%= @user.university_email if @edit == "0" %></p>
      <% if @edit == "1" %>
        <input type="text" name="university_email" value="<%= @user.university_email %>" required>
      <% end %>
    </div>

    <div class="info row languages">
      <% @languages = @user.languages.split(",") unless @user.languages.nil? %>
      <p>Languages Spoken: <%= ' (Comma separated, no spaces)' if @edit == "1" %></p>

      <ul>
        <% if @edit == "0" && !@languages.nil?%>
          <% @languages.each do |language|%>
            <li><%= language %></li>
          <% end %>
        <% end %>
      </ul>

      <% if @edit == "1" %>
        <input type="text" name="languages" value="<%= @user.languages %>" required>
      <% end %>
    </div>

    <div class="info row">
      <p><%= @edit == "0" ? ("Age: " + @user.age(@user.date_of_birth).to_s) : "Date of Birth:" %></p>
      <% if @edit == "1" %>
        <input type="date" name="date_of_birth" value="<%= @user.date_of_birth %>" required>
      <% end %>
    </div>

    <div class="info row">
      <p>Role: <%= @user.acc_type %></p>
      <% if @edit == "1" && @user.acc_type == "admin"%>
        <select name="acc_type" required>
          <option value="mentee" <%= 'selected' if @user.acc_type == "mentee" %>>Mentee</option>
          <option value="mentor" <%= 'selected' if @user.acc_type == "mentor" %>>Mentor</option>
          <option value="admin" <%= 'selected' if @user.acc_type == "admin" %>>Admin</option>
        </select>
      <% end %>
    </div>

    <div class="info row">
      <p>Nationality: <%= @user.nationality if @edit == "0" %> </p>
      <% if @edit == "1" %>
        <select name="nationality" required>
          <% @countries.each do |country| %>
            <option value="<%= country %>" <%= 'selected' if @user.nationality == country %>><%= country %></option>
          <% end %>
        </select>
      <% end %>
    </div>


    <div class="info row">
      <% # set year of study to empty if @user doesn't have it, else instantiate it %>
      <% @user.year_of_study.nil? ? @year_of_study = "" : @year_of_study = @user.year_of_study %>
      <p>Year of Study: <%= @year_of_study if @edit == "0" || @user.acc_type != "admin" %> </p>
      <% # Only admins can edit a user's profile page %>
      <% if @edit == "1" && @user.acc_type == "admin" %>
        <select name="year_of_study" required>
          <% # If user already has a year of study, preselect it %>
          <% if !@user.year_of_study.nil? %>
            <% (1..5).each do |year| %>
              <option value="Year <%= year %>" <%= 'selected' if @year_of_study[0..5] == "Year #{year}" %>>Year <%= year %></option>
            <% end %>
          <% else %>
            <% (1..5).each do |year| %>
              <option value="Year <%= year %>">Year <%= year %></option>
            <% end %>
          <% end %>
        </select>
      <% end %>
    </div>

    <% if @edit == "1" %>
      <button type="submit">Save</button>
    <% else %>
      <button type="submit">Edit</button>
    <% end %>
  </form>
</section>
</body>

<%= erb :footer %>

</html>
