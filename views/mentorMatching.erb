<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Matches</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<% @title = "Matching" %>
<%= erb :"common/header" %>

<div class="content">
    <h1 id="welcome" class="centerer">Mentees</h1>
    <div id="mentee-list" class="content-box">
        <div id="mentee-applicants">
            <h2>Mentee applications</h2>
            <% @menteeApplicants.each do |row| %>
                <div class="profile-box">
                    <% mentee = row.mentee %>
                    <div class="basic-info">
                        <span class="profile_pic">
                            <% if mentee.profile_picture %> 
                                <img id="profile-menu" src="<%= "/images/user/#{mentee.profile_picture}" %>" alt="Profile Picture">
                            <% else %>
                                <img id="profile-menu" src="blackProfilePicture.webp" alt="Profile Picture">
                            <% end %>
                        </span>
                        <span class="profile-name">
                            <p><%= mentee.first_name %> <%= mentee.last_name %></p>
                        </span>
                    </div>
                    <div detailed-info>
                        <span class="profile-dob">
                            <p><%= mentee.date_of_birth %></p>
                        </span>
                        <span class="row profile-nationality">
                            <p><%= Nationality.first(id: mentee.nationality_id).country_name %></p>
                        </span>
                        <span class="row profile-bio-detailed">
                            <p><%= mentee.bio_detailed %></p>
                        </span>
                    </div>
            <% end %>
        </div>
        <div id="mentee-others">
            <h2>Other Mentees</h2>
            <% @mentees.all.each do |row| %>
                <div class="profile-box">
                    <% mentee = row.user.profile %>
                    <div class="basic-info centerer">
                        <div class="profile_pic">
                            <% if mentee.profile_picture %> 
                                <img id="profile-menu" src="<%= "/images/user/#{mentee.profile_picture}" %>" alt="Profile Picture">
                            <% else %>
                                <img id="profile-menu" src="blackProfilePicture.webp" alt="Profile Picture">
                            <% end %>
                        </div>
                        <p class="profile-name"><%= mentee.first_name %> <%= mentee.last_name %></p>
                    </div>
                    <div class="detailed-info">
                        <p class="detailed-info-content">Age: <%= mentee.age %></p>
                        <p class="detailed-info-content">Nationality: <%= Nationality.first(id: mentee.nationality_id).country_name %></p>
                    </div>
                    <div class="bio-and-accept">
                        <p class="profile-bio-detailed">Bio: <%= mentee.bio_detailed %></p>
                        <div class="matching-wrapper" id="<%= row.user.id %>-wrapper">
                            <button type="button" class="apply-mentor" id="<%= row.user.id %>-apply">Apply</button>
                        </div>
                    </div>
                </div>
            <% end %>
        </div>
    </div>
</div>

  </div>
</body>

</html>