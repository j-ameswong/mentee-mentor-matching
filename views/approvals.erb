<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Approvals</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css"/>
</head>

<% @title = "Approvals" %>
<%= erb :"common/header" %>
<% @userCount = 0 %>

<body>
  <div class="content">
		<div class="centerer column content-container">
		<select name="filter-accounts" class="account-filter">
			<option value="All">All</option>
			<option value="Admin">Admins</option>
			<option value="Mentor">Mentors</option>
			<option value="Mentee">Mentees</option>
		</select>
    <section class="row centerer">
      <% @unapproved.each do |auth| %>
        <div class="column centerer">
          <p class="content-box approvals centerer"><%= auth.user.email %>:
            <% if !auth.user.admin? %>
              <a href="<%= "/approvals/approve?to_approve=#{auth.user.id}"%>">Approve</a>
              <a href="<%= "/approvals/deny?to_deny=#{auth.user.id}"%>">Deny</a>
              <%= auth.user.role.capitalize %></p>
            <% else %>
              <div class="centerer">
                <form method="post" action="/approvals">
                  <input type="hidden" name="id" value="<%= auth.user.id %>">
                  <input id="password" type="password" name="password">
                  <label for="password">Temporary Password</label>

                  <input id="confirm_password" type="password" name="confirm_password">
                  <label for="confirm_password">Confirm Temporary Password</label>

                  <select name="approved">
                    <option value="approve">Approve</option>
                    <option value="deny">Deny</option>
                  </select>

                  <input type="submit" value="Submit">
                </form>
              </div>
            <% end %>
          </div>
        </section>
      </div>
			</div>
    <% end %>
</body>

</html>

