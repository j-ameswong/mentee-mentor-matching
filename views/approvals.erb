<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Approvals</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css"/>
</head>

<% @title = "Approvals" %>
<%= erb :"common/header" %>
<% @userCount = 0 %>

<body>
  <div class="content">
    <section class="row centerer">
      <% @unapproved.each do |user| %>
        <div class="column centerer">
          <p class="content-box approvals centerer"><%= user.university_email %>:
            <% if user.acc_type != "admin" %>
              <%= user.acc_type.titleize %>
              <a href="<%= "/approvals/approve?to_approve=#{user.id}"%>">Approve</a>
              <a href="<%= "/approvals/deny?to_deny=#{user.id}"%>">Deny</a>
              

            <% elsif user.acc_type == "admin" %>
              <div class="centerer">
                <form method="post" action="/approvals">
                  <input type="hidden" name="id" value="<%= user.id %>">
                  <input type="text" name="temp_password">
                  <label for="temp_password">Temporary Password</label>

                  <select name="approved">
                    <option value="approve">Approve</option>
                    <option value="deny">Deny</option>
                  </select>

                  <input type="submit" value="Submit">
                </form>
              </div>
            <% end %>
          </p>
        </div>
      <% end %>
    </section>
  </div>
</body>

</html>

