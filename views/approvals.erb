<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Approvals</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css"/>
</head>

<% @title = "Approvals" %>
<%= erb :"common/header" %>

<body>
  <% @unapproved.each do |auth| %>
  <p><%= auth.user.email %>:
    <% if !auth.user.admin? %>
      <a href="<%= "/approvals/approve?to_approve=#{auth.user.id}"%>">Approve</a>
      <a href="<%= "/approvals/deny?to_deny=#{auth.user.id}"%>">Deny</a>
      <p><%= auth.user.role %></p>

    <% else %>
      <div style="width: 10rem" class="row">
        <form method="post" action="/approvals">
          <input type="hidden" name="id" value="<%= auth.user.id %>">
          <input id="password" type="password" name="password">
          <label for="password">Temporary Password</label>

          <input id="confirm_password" type="password" name="confirm_password">
          <label for="confirm_password">Confirm Temporary Password</label>

          <select name="approved">
            <option value="approve">Approve</option>
            <option value="deny">Deny</option>
          </select>

          <input type="submit" value="Submit">
        </form>
      </div>
    <% end %>
  <% end %>
</body>

</html>

