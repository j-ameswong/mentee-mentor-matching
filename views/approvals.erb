<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Approvals</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css"/>
</head>

<% @title = "Approvals" %>
<%= erb :"common/header" %>
<% @userCount = 0 %>

<body>
    <div class="content">
		<div id="filter">
            <form method="get" action="/approvals">
                <label id="filter-label">Filter by:</label>
                <select name="filter-accounts" id="account-filter" onchange="this.form.submit()">
                    <option value="All" <%= "selected" if params[:'filter-accounts'].nil?%>>All</option>
                    <option value="Admin" <%= "selected" if params[:'filter-accounts'] == "Admin" %>>Admins</option>
                    <option value="Mentor" <%= "selected" if params[:'filter-accounts'] == "Mentor" %>>Mentors</option>
                    <option value="Mentee" <%= "selected" if params[:'filter-accounts'] == "Mentee" %>>Mentees</option>
                </select>
            </form>
		</div>
        <section class="row centerer">
            <% @unapproved.each do |auth| %>
                <div class="column centerer content-box approvals">
                    <p id="role-text"> <%= auth.user.role.capitalize %> </p>
                    <p id="email-text"><%= auth.user.email %> </p>
                    <% if !auth.user.admin? %>
                        <div class="approval-decision">
                            <a class="approval-btn" href="<%= "/approvals/approve?to_approve=#{auth.user.id}"%>">Approve</a>
                            <a class="deny-btn" href="<%= "/approvals/deny?to_deny=#{auth.user.id}"%>">Deny</a>
                        </div>
                    <% else %>
                        <div class="centerer">
                        <form method="post" action="/approvals">
                            <input type="hidden" name="id" value="<%= auth.user.id %>">
                            <input id="password" type="password" name="password">
                            <label for="password">Temporary Password</label>

                            <input id="confirm_password" type="password" name="confirm_password">
                            <label for="confirm_password">Confirm Temporary Password</label>

                            <select name="approved" class="approval-decision">
                                <option class="approval-btn" value="approve">Approve</option>
                                <option class="deny-btn" value="deny">Deny</option>
                            </select>

                            <input type="submit" value="Submit">
                        </form>
                        </div>
                    <% end %>
                </div>
            <% end %>
		</section>
	</div>
</body>

</html>

