<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Matches</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css"/>
</head>
<% @title = "Support" %>
<%= erb :"common/header" %>

<body>
  <div class="content">
    <h3>Support Tickets</h3>
    <div id="filter">
        <form action="/support/filter" method="post" id="filter-form">
        <label for="account-filter" id="filter-label">Filter by:</label>
        <select name="filter-accounts" id="account-filter">
            <option <%= "selected" if @filter == "All" %> value="all">All</option>
            <option <%= "selected" if @filter == "Withdrawal" %> value="1">Withdrawals</option>
            <option <%= "selected" if @filter == "Report" %> value="2">Report</option>
            <option <%= "selected" if @filter == "Account Deletion" %> value="4">Account Deletion</option>
        </select>
        </form>
    </div>
    <section class="row centerer approvals-wrapper">
        <% @tickets.each do |ticket| %>
            <% if @filter == "all" || ticket.type.to_s == @filter %>
                <div class="centerer content-box approvals">
                    <div class="row centerer">
                      <p id="ticket-sender"><%= ticket.ticket_type.desc_brief %></p>
                    </div>
                    <% if ticket.type == 1 %> <!-- Withdrawal -->
                        <div class="row centerer">
                            <p id="ticket-receiver">Sent by: <a href=<%= "/profile?id=#{ticket.sent_by_user.id}" %>><%= ticket.sent_by_user.username %></a></p>
                        </div>
                        <div class="row centerer">
                          <p id="ticket-receiver">Target: <a href=<%= "/profile?id=#{ticket.target_id_user.id}" %>><%= ticket.target_id_user.username %></a></p>
                        </div>
                        <div class="row centerer">
                            <p id="ticket-details">Reason: <%= ticket.details %> </p>
                        </div>
                        <div class="approval-decision centerer">
                          <form action="/support/decision" method="post" id="decision-form">
                            <input type="hidden" name="ticket_id" value="<%= ticket.id %>">
                            <div class="row centerer">
                              <button name="approve" type="submit" class="approval-btn column">Approve</button>
                              <button name="deny" class="deny-btn column">Deny</button>
                            </div>
                          </form>
                        </div>
                    <% elsif ticket.type == 2 %> <!-- Report -->
                        <div class="row centerer">
                          <p id="ticket-receiver">Sent by: <a href=<%= "/profile?id=#{ticket.sent_by_user.id}" %>><%= ticket.sent_by_user.username %></a></p>
                        </div>
                        <div class="row centerer">
                          <p id="ticket-receiver">Target: <a href=<%= "/profile?id=#{ticket.target_id_user.id}" %>><%= ticket.target_id_user.username %></a></p>
                        </div>
                        <div class="row centerer">
                            <p id="ticket-details">Reason: <%= ticket.details %> </p>
                        </div>
                        <div class="approval-decision centerer">
                          <form action="/support/decision" method="post" id="decision-form">
                            <input type="hidden" name="ticket_id" value="<%= ticket.id %>">
                            <button name="flag" type="submit" class="approval-btn">Flag</button>
                            <button name="dismiss" type="submit" class="approval-btn">Dismiss</button>
                          </form>
                        </div>
                    <% elsif ticket.type == 4 %> <!-- Account deletion -->
                        <div class="row centerer">
                            <p id="ticket-details">Details: <%= ticket.details %> </p>
                        </div>
                        <div class="approval-decision centerer">
                            <a class="approval-btn" href="<%= %>">Approve</a>
                            <a class="deny-btn" href="<%= %>">Deny</a>
                        </div>
                    <% end %>
                </div>
            <% end %>
        <% end %>
    </section>
  </div>
<script src="/js/approvalFilter.js"></script>
</body>

</html>