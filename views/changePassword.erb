<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Account</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" href="/images/UniConnectLogo.png" type="image/x-icon">
</head>

<% @title = "Change Password" %>
<%= erb :"common/header" %>

<body>
<section class="content" id="edit_profile">
  <h2 class="welcome">Change Password</h2>
  <div class="content-box centerer">
    <form action="/account/changePassword" method="post">
      <div style"width:50%;"class="column">
        <div class="row">
          <label for="old_password">Old Password:</label>
          <input style="width:100%;" type="password" name="old_password" id="old_password" required>
          <% if @user && @user.errors[:password] %>
            <p class="error"><%= @user.errors[:password].each { |error| puts error } %></p>
          <% end %>
        </div>

        <div class="row">
          <label for="new_password">New Password:</label>
          <input style="width:100%;" type="password" name="new_password" id="new_password" required>
          <% if @user && @user.errors[:new_password] %>
            <p class="error"><%= @user.errors[:new_password].each { |error| puts error } %></p>
          <% end %>
        </div>

        <div class="row">
          <label for="confirm_password">Confirm New Password:</label>
          <input style="width:100%;" type="password" name="confirm_password" id="confirm_password" required>
          <% if @user && @user.errors[:confirm_password] %>
            <p class="error"><%= @user.errors[:confirm_password].each { |error| puts error } %></p>
          <% end %>
        </div>

        <div id="change-pass-submit" class="column">
          <input type="submit" value="Change Password">
          <% if @success %>
            <p class="success">Password changed successfully!</p>
          <% end %>
        </div>
      </div>
    </form>
  </div>
</section>
</body>

</html>
