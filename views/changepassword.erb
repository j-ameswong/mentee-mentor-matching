<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Account</title>
  <meta name="author" content="Team 17">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<% @title = "Change Password" %>
<%= erb :"common/header" %>

<body>
<section id="edit_profile">
  <a href="/account">< Back</a>
  <h1>Change Password</h1>
  <form action="/account/changepassword" method="post">
    <div class="column">
      <div class="row">
        <label for="old_password">Old Password:</label>
        <input type="password" name="old_password" id="old_password" required>
        <% if !@user.nil? && !@user.errors.nil? && @user.errors.include?("password") %>
          <p class="error"><%= @user.errors["password"][0] %></p>
        <% end %>
      </div>

      <div class="row">
        <label for="new_password">New Password:</label>
        <input type="password" name="new_password" id="new_password" required>
        <% if !@user.nil? && !@user.errors.nil? && @user.errors.include?("new_password") %>
          <p class="error"><%= @user.errors["new_password"][0] %></p>
        <% end %>
      </div>

      <div class="row">
        <label for="confirm_password">Confirm New Password:</label>
        <input type="password" name="confirm_password" id="confirm_password" required>
        <% if !@user.nil? && !@user.errors.nil? && @user.errors.include?("confirm_password") %>
          <p class="error"><%= @user.errors["confirm_password"][0] %></p>
        <% end %>
      </div>

      <div class="column">
        <input type="submit" value="Change Password">
        <% if @success == "true" %>
          <p class="success">Password changed successfully!</p>
        <% end %>
      </div>
    </div>
  </form>
</section>
</body>

</html>
